NODE_ENV=development
PORT=3000

# Database (Supabase)
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSL=true

# Artifacts
ARTIFACT_BASE_URL=https://pub-8bc2ba0d7e7647799d89662d70f23c45.r2.dev

# App
APP_VERSION=0.1.0

# Telemetry (I1 / W1) — see docs/TELEMETRY_OPERATIONS.md
# Disabled unless explicitly turned on. Setting this to anything other than "true" disables
# intake, which is also the rollback switch.
TELEMETRY_ENABLED=false
# Sink for validated events: "log" (structured Pino output) or "none" (accept and discard).
TELEMETRY_SINK=log
# Requests per minute per client for the telemetry endpoint.
TELEMETRY_RATE_LIMIT_MAX=60
# How long an event_id is remembered for de-duplication, and the cap on remembered IDs.
TELEMETRY_DEDUPE_TTL_SECONDS=3600
TELEMETRY_DEDUPE_MAX_ENTRIES=20000
# Delivery retries after the first attempt, and the base backoff between attempts.
TELEMETRY_SINK_MAX_RETRIES=2
TELEMETRY_SINK_RETRY_DELAY_MS=200
# Concurrent in-flight deliveries before batches are shed rather than queued.
TELEMETRY_SINK_MAX_IN_FLIGHT=50

# Operational metrics snapshot at GET /internal/metrics
METRICS_ENDPOINT_ENABLED=true
