# ─────────────────────────────────────────
# WellaPath Backend — Environment Variables
# Copy this file to .env and fill in values
# Never commit .env to Git
# ─────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DB_HOST=wellapath-staging-db.cclsme0gujar.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=wellapath_staging
DB_USER=wellapath_admin
DB_PASSWORD=

# AWS
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=812527292522

# S3 / Artifacts
S3_BUCKET=wellapath-artifacts-staging
ARTIFACT_BASE_URL=https://d179u2ex0g66o3.cloudfront.net

# Secrets Manager ARNs
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:812527292522:secret:wellapath/staging/db-dgHN1G
APP_SECRET_ARN=arn:aws:secretsmanager:us-east-1:812527292522:secret:wellapath/staging/app-0rFlFx

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
```

