NODE_ENV=development
PORT=3000

# Database (Supabase)
# Master switch. Defaults to true when absent. Must be exactly "true" or "false" — any other
# value refuses startup. With DATABASE_ENABLED=false, no DB_* variable below is required or
# read, no connection pool is created, and /health reports database: "disabled". No current
# product route requires the database; production launches with it disabled.
DATABASE_ENABLED=true
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSL=true

# Artifacts
ARTIFACT_BASE_URL=https://pub-8bc2ba0d7e7647799d89662d70f23c45.r2.dev

# App
APP_VERSION=0.1.0

# Telemetry (I1 / W1) — see docs/TELEMETRY_OPERATIONS.md
# Disabled unless explicitly turned on. Setting this to anything other than "true" disables
# intake, which is also the rollback switch.
TELEMETRY_ENABLED=false
# Sink for validated events: "log" (structured Pino output) or "none" (accept and discard).
TELEMETRY_SINK=log
# Requests per minute per client for the telemetry endpoint.
TELEMETRY_RATE_LIMIT_MAX=60
# How long an event_id is remembered for de-duplication, and the cap on remembered IDs.
TELEMETRY_DEDUPE_TTL_SECONDS=3600
TELEMETRY_DEDUPE_MAX_ENTRIES=20000
# Delivery retries after the first attempt, and the base backoff between attempts.
TELEMETRY_SINK_MAX_RETRIES=2
TELEMETRY_SINK_RETRY_DELAY_MS=200
# Concurrent in-flight deliveries before batches are shed rather than queued.
TELEMETRY_SINK_MAX_IN_FLIGHT=50

# Operational metrics snapshot at GET /internal/metrics
METRICS_ENDPOINT_ENABLED=true

# Trusted proxies (ADR-001 A3). The MEASURED number of proxies in front of the service
# (Cloudflare -> Render). Unset = trust none: request.ip is the socket peer. Never "true".
# TRUST_PROXY_HOPS=

# Community (ADR-001). OFF unless COMMUNITY_MODE is set. With it unset, no Community or auth
# route exists, Better Auth is not loaded and none of the variables below is read.
# See docs/COMMUNITY_POC.md. Secrets live in the Render environment only — never in this file.
# COMMUNITY_MODE=disabled
# COMMUNITY_DATABASE_URL=
# BETTER_AUTH_SECRETS=          # "<version>:<secret>,..." newest first (>= 32 chars each)
# COMMUNITY_REFRESH_PEPPERS=    # "<version>:<secret>,..." distinct from the auth secrets
# COMMUNITY_ALLOWLIST=
# COMMUNITY_EMAIL_PROVIDER=resend   # resend (required under NODE_ENV=production) | outbox-file | memory (test sinks)
# RESEND_API_KEY=                   # Render environment only; never logged
# COMMUNITY_EMAIL_FROM=             # "WellaPath <no-reply@verified-domain>"
# COMMUNITY_EMAIL_TIMEOUT_MS=5000
# COMMUNITY_AUTH_PURGE_INTERVAL_SECONDS=900   # sign-in retention purge, 60-3600
