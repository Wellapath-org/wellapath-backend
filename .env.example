NODE_ENV=development
PORT=3000

# Database (Supabase)
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSL=true

# Artifacts
ARTIFACT_BASE_URL=https://pub-8bc2ba0d7e7647799d89662d70f23c45.r2.dev

# App
APP_VERSION=0.1.0

# Telemetry (I1 / W1) — see docs/TELEMETRY_OPERATIONS.md
# Disabled unless explicitly turned on. Setting this to anything other than "true" disables
# intake, which is also the rollback switch.
TELEMETRY_ENABLED=false
# Sink for validated events: "log" (structured Pino output) or "none" (accept and discard).
TELEMETRY_SINK=log
# Requests per minute per client for the telemetry endpoint.
TELEMETRY_RATE_LIMIT_MAX=60
# How long an event_id is remembered for de-duplication, and the cap on remembered IDs.
TELEMETRY_DEDUPE_TTL_SECONDS=3600
TELEMETRY_DEDUPE_MAX_ENTRIES=20000
# Delivery retries after the first attempt, and the base backoff between attempts.
TELEMETRY_SINK_MAX_RETRIES=2
TELEMETRY_SINK_RETRY_DELAY_MS=200
# Concurrent in-flight deliveries before batches are shed rather than queued.
TELEMETRY_SINK_MAX_IN_FLIGHT=50

# Operational metrics snapshot at GET /internal/metrics
METRICS_ENDPOINT_ENABLED=true

# Facilities 2.0 distribution (I3) — see docs/FACILITIES_V2_DISTRIBUTION.md
#
# ALL of these default to false or absent, and must stay that way until the Facilities 2.0
# candidate clears its licence, attribution, coverage, sizing and approval gates. With every
# variable unset, /config is byte-identical to the frozen v1.1 baseline. An enabled-but-invalid
# declaration is refused at startup (v1.1 keeps serving; reason codes are logged, values are
# not). No combination of these variables can expose an artifact whose status is not exactly
# "approved" with may_publish exactly "true".
#
# FACILITIES_V2_DISTRIBUTION_ENABLED=false
# FACILITIES_V2_STATUS=
# FACILITIES_V2_MAY_PUBLISH=
# FACILITIES_V2_ARTIFACT_VERSION=
# FACILITIES_V2_SCHEMA_VERSION=
# FACILITIES_V2_URL=
# FACILITIES_V2_SHA256=
# FACILITIES_V2_BYTE_COUNT=
# FACILITIES_V2_SOURCE_VERSION=
# FACILITIES_V2_PUBLICATION_DECISION_REF=
# FACILITIES_V2_PRODUCTION_APPROVED=false
