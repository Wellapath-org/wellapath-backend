{
  "description": "Negative governance fixtures. Each case mutates the valid baseline manifest fixture and declares the stage it must fail at and the exact reason code it must fail for. The runner (tests/unit/manifest-fixtures.test.ts) asserts each case fails at its declared stage with its declared code — a case failing for a different reason is itself a test failure.",
  "base": "baseline.manifest.json",
  "target": {
    "artifact_id": "knowledge_base",
    "artifact_version": "2.4"
  },
  "context": {
    "environment": "staging",
    "app_build": 100,
    "now": "2026-08-28T00:00:00Z"
  },
  "cases": [
    {
      "name": "unknown manifest major version is rejected",
      "stage": "validation",
      "expected_code": "MANIFEST_VERSION_UNSUPPORTED",
      "manifest_overrides": {
        "manifest_version": "2.0.0"
      }
    },
    {
      "name": "non-semver manifest version is rejected",
      "stage": "validation",
      "expected_code": "MANIFEST_VERSION_UNSUPPORTED",
      "manifest_overrides": {
        "manifest_version": "two point oh"
      }
    },
    {
      "name": "unknown required feature is rejected, not ignored",
      "stage": "validation",
      "expected_code": "UNKNOWN_REQUIRED_FEATURE",
      "manifest_overrides": {
        "required_features": ["signed_manifests"]
      }
    },
    {
      "name": "unknown top-level manifest field is rejected",
      "stage": "validation",
      "expected_code": "UNKNOWN_FIELD",
      "manifest_overrides": {
        "distribution_mode": "automatic"
      }
    },
    {
      "name": "unknown descriptor field is rejected",
      "stage": "validation",
      "expected_code": "UNKNOWN_FIELD",
      "descriptor_overrides": {
        "auto_activate": true
      }
    },
    {
      "name": "missing required descriptor field is rejected",
      "stage": "validation",
      "expected_code": "MISSING_REQUIRED_FIELD",
      "remove_descriptor_fields": ["sha256"]
    },
    {
      "name": "missing clinical approval record is rejected",
      "stage": "validation",
      "expected_code": "APPROVAL_MISSING",
      "remove_descriptor_fields": ["approvals.clinical"]
    },
    {
      "name": "unknown approval status is rejected, never coerced",
      "stage": "validation",
      "expected_code": "APPROVAL_STATUS_UNKNOWN",
      "descriptor_overrides": {
        "approvals": {
          "clinical": {
            "status": "auto_approved"
          }
        }
      }
    },
    {
      "name": "unsupported artifact schema is rejected",
      "stage": "validation",
      "expected_code": "UNSUPPORTED_ARTIFACT_SCHEMA",
      "descriptor_overrides": {
        "schema_version": "wellapath.artifact/9"
      }
    },
    {
      "name": "malformed sha256 is rejected",
      "stage": "validation",
      "expected_code": "MALFORMED_FIELD",
      "descriptor_overrides": {
        "sha256": "sha256:not-a-real-digest"
      }
    },
    {
      "name": "wrong content type is rejected",
      "stage": "validation",
      "expected_code": "CONTENT_TYPE_UNSUPPORTED",
      "descriptor_overrides": {
        "content_type": "text/html"
      }
    },
    {
      "name": "activation authorization without a decision reference is rejected",
      "stage": "validation",
      "expected_code": "MALFORMED_FIELD",
      "descriptor_overrides": {
        "activation_decision_ref": null
      }
    },
    {
      "name": "duplicate artifact identity is rejected",
      "stage": "validation",
      "expected_code": "DUPLICATE_IDENTITY",
      "append_duplicate_of_target": true
    },
    {
      "name": "predecessor/rollback relationship cycle is rejected",
      "stage": "validation",
      "expected_code": "RELATIONSHIP_CYCLE",
      "other_descriptor_overrides": {
        "artifact_id": "knowledge_base",
        "artifact_version": "2.3",
        "overrides": {
          "rollback_target": {
            "artifact_version": "2.4",
            "sha256": "sha256:6c00d8257f8417e86bd5e237630bf8a4623ad72e2e46b1b071dd447c067cec2b"
          }
        }
      }
    },
    {
      "name": "self-referencing rollback target is rejected as a cycle",
      "stage": "validation",
      "expected_code": "RELATIONSHIP_CYCLE",
      "descriptor_overrides": {
        "rollback_target": {
          "artifact_version": "2.4",
          "sha256": "sha256:6c00d8257f8417e86bd5e237630bf8a4623ad72e2e46b1b071dd447c067cec2b"
        }
      }
    },
    {
      "name": "rollback target that resolves to no descriptor is rejected",
      "stage": "validation",
      "expected_code": "INVALID_ROLLBACK_TARGET",
      "descriptor_overrides": {
        "rollback_target": {
          "artifact_version": "9.9",
          "sha256": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      }
    },
    {
      "name": "rollback target with a mismatched hash is rejected",
      "stage": "validation",
      "expected_code": "INVALID_ROLLBACK_TARGET",
      "descriptor_overrides": {
        "rollback_target": {
          "artifact_version": "2.3",
          "sha256": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      }
    },
    {
      "name": "arbitrary external origin is rejected",
      "stage": "validation",
      "expected_code": "ORIGIN_NOT_APPROVED",
      "descriptor_overrides": {
        "url": "https://cdn.example-attacker.com/kb.ng.v2.4.json"
      }
    },
    {
      "name": "plain http origin is rejected",
      "stage": "validation",
      "expected_code": "ORIGIN_NOT_HTTPS",
      "descriptor_overrides": {
        "url": "http://pub-8bc2ba0d7e7647799d89662d70f23c45.r2.dev/kb.ng.v2.4.json"
      }
    },
    {
      "name": "url with embedded credentials is rejected",
      "stage": "validation",
      "expected_code": "ORIGIN_HAS_CREDENTIALS",
      "descriptor_overrides": {
        "url": "https://svc:hunter2@pub-8bc2ba0d7e7647799d89662d70f23c45.r2.dev/kb.ng.v2.4.json"
      }
    },
    {
      "name": "url with a query-string secret is rejected",
      "stage": "validation",
      "expected_code": "ORIGIN_HAS_QUERY",
      "descriptor_overrides": {
        "url": "https://pub-8bc2ba0d7e7647799d89662d70f23c45.r2.dev/kb.ng.v2.4.json?token=abc123"
      }
    },
    {
      "name": "a decision scoped away from publication cannot occupy an approval slot",
      "stage": "validation",
      "expected_code": "APPROVAL_SCOPE_MISMATCH",
      "descriptor_overrides": {
        "approvals": {
          "product": {
            "status": "granted",
            "decision_ref": "a real, complete Product display decision",
            "decision_scope": ["product_display"]
          }
        }
      }
    },
    {
      "name": "unknown approval scope is rejected, never read as authorisation",
      "stage": "validation",
      "expected_code": "APPROVAL_SCOPE_UNKNOWN",
      "descriptor_overrides": {
        "approvals": {
          "product": {
            "decision_scope": ["artifact_publication_v2"]
          }
        }
      }
    },
    {
      "name": "a granted approval that records no scope at all is rejected",
      "stage": "validation",
      "expected_code": "APPROVAL_SCOPE_MISSING",
      "descriptor_overrides": {
        "approvals": {
          "clinical": {
            "status": "granted",
            "decision_ref": "an unscoped decision",
            "decision_scope": null
          }
        }
      }
    },
    {
      "name": "a granted approval whose decision_scope key is absent entirely is rejected",
      "stage": "validation",
      "expected_code": "APPROVAL_SCOPE_MISSING",
      "remove_descriptor_fields": ["approvals.product.decision_scope"]
    },
    {
      "name": "required clinical approval still pending denies eligibility",
      "stage": "eligibility",
      "expected_code": "APPROVAL_NOT_GRANTED",
      "descriptor_overrides": {
        "approvals": {
          "clinical": {
            "status": "pending",
            "decision_ref": null,
            "approved_at": null
          }
        }
      }
    },
    {
      "name": "explicitly denied approval denies eligibility",
      "stage": "eligibility",
      "expected_code": "APPROVAL_NOT_GRANTED",
      "descriptor_overrides": {
        "approvals": {
          "clinical": {
            "status": "denied",
            "decision_ref": "clinical review rejection",
            "approved_at": null
          }
        }
      }
    },
    {
      "name": "unresolved safety blocker denies eligibility",
      "stage": "eligibility",
      "expected_code": "BLOCKER_UNRESOLVED",
      "descriptor_overrides": {
        "blockers": [
          {
            "id": "SB-999",
            "status": "open"
          }
        ]
      }
    },
    {
      "name": "activation without publication denies eligibility",
      "stage": "eligibility",
      "expected_code": "NOT_PUBLISHED",
      "descriptor_overrides": {
        "release_status": "candidate",
        "published_at": null
      }
    },
    {
      "name": "environment mismatch denies eligibility",
      "stage": "eligibility",
      "expected_code": "ENVIRONMENT_NOT_AUTHORIZED",
      "descriptor_overrides": {
        "target_environments": ["production"]
      }
    },
    {
      "name": "incompatible app build denies eligibility",
      "stage": "eligibility",
      "expected_code": "APP_BUILD_INCOMPATIBLE",
      "descriptor_overrides": {
        "min_app_build": 999
      }
    },
    {
      "name": "unknown consumer build fails closed when a minimum is declared",
      "stage": "eligibility",
      "expected_code": "APP_BUILD_INCOMPATIBLE",
      "descriptor_overrides": {
        "min_app_build": 1
      },
      "context_overrides": {
        "app_build": null
      }
    },
    {
      "name": "expired descriptor denies eligibility",
      "stage": "eligibility",
      "expected_code": "DESCRIPTOR_EXPIRED",
      "descriptor_overrides": {
        "expires_at": "2026-01-01T00:00:00Z"
      }
    },
    {
      "name": "deprecated descriptor denies eligibility",
      "stage": "eligibility",
      "expected_code": "DESCRIPTOR_DEPRECATED",
      "descriptor_overrides": {
        "deprecated": true
      }
    },
    {
      "name": "publication without activation selects nothing",
      "stage": "selection",
      "expected_code": "NOT_ACTIVE",
      "descriptor_overrides": {
        "activation_status": "inactive"
      }
    },
    {
      "name": "candidate existence is never treated as eligibility",
      "stage": "selection",
      "expected_code": "NO_ACTIVE_ARTIFACT",
      "descriptor_overrides": {
        "release_status": "candidate",
        "published_at": null,
        "activation_status": "inactive",
        "activation_authorized": false,
        "activation_decision_ref": null,
        "approvals": {
          "product": {
            "status": "pending",
            "decision_ref": null,
            "approved_at": null
          },
          "clinical": {
            "status": "pending",
            "decision_ref": null,
            "approved_at": null
          }
        }
      }
    },
    {
      "name": "two simultaneously active descriptors select nothing",
      "stage": "selection",
      "expected_code": "MULTIPLE_ACTIVE",
      "other_descriptor_overrides": {
        "artifact_id": "knowledge_base",
        "artifact_version": "2.3",
        "overrides": {
          "activation_status": "active",
          "activation_authorized": true,
          "activation_decision_ref": "fixture: erroneously double-activated"
        }
      }
    },
    {
      "name": "bytes that do not hash to the declared sha256 are rejected",
      "stage": "integrity",
      "expected_code": "HASH_MISMATCH",
      "descriptor_overrides": {
        "sha256": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "byte_count": 20
      },
      "bytes_utf8": "integrity-test-bytes"
    },
    {
      "name": "bytes with the wrong byte count are rejected",
      "stage": "integrity",
      "expected_code": "BYTE_COUNT_MISMATCH",
      "descriptor_overrides": {
        "sha256": "sha256:eb067846e47a7fca01e9e122ab083e1ef48508d78dbaa0249fe57b2c1261fc8c",
        "byte_count": 9999
      },
      "bytes_utf8": "integrity-test-bytes"
    }
  ]
}
